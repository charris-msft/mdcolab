{
  "name": "vscode-mdcolab",
  "displayName": "mdcolab",
  "description": "Collaborative markdown review with anchored comments via GitHub Issues",
  "version": "0.4.7",
  "publisher": "charris-msft",
  "engines": {
    "vscode": "^1.116.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:markdown",
    "onView:mdcolab.commentsView"
  ],
  "main": "./out/extension.js",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/charris-msft/mdcolab"
  },
  "contributes": {
    "languageModelTools": [
      {
        "name": "mdcolab_addComment",
        "tags": [
          "mdcolab",
          "comment",
          "review",
          "markdown"
        ],
        "toolReferenceName": "mdcolabAddComment",
        "displayName": "Add mdcolab Comment",
        "modelDescription": "Add a review comment anchored to specific text in the currently open markdown document. The comment is stored as a GitHub Issue. Use this when the user asks to add a comment on a specific word, phrase, or section.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "selectedText": {
              "type": "string",
              "description": "The exact text in the document to anchor the comment to. Must match text that exists in the document."
            },
            "body": {
              "type": "string",
              "description": "The comment body text."
            }
          },
          "required": [
            "selectedText",
            "body"
          ]
        },
        "canBeReferencedInPrompt": true
      },
      {
        "name": "mdcolab_addGeneralComment",
        "tags": [
          "mdcolab",
          "comment",
          "review",
          "markdown"
        ],
        "toolReferenceName": "mdcolabAddGeneralComment",
        "displayName": "Add mdcolab General Comment",
        "modelDescription": "Add a general document-level review comment not anchored to specific text. Use this when the user wants to comment on the document as a whole, not a specific phrase.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "body": {
              "type": "string",
              "description": "The comment body text."
            }
          },
          "required": [
            "body"
          ]
        },
        "canBeReferencedInPrompt": true
      },
      {
        "name": "mdcolab_listComments",
        "tags": [
          "mdcolab",
          "comment",
          "review",
          "markdown"
        ],
        "toolReferenceName": "mdcolabListComments",
        "displayName": "List mdcolab Comments",
        "modelDescription": "List review comment threads on the currently open markdown document. Returns issue numbers, status, anchored text, and comment bodies. Use this to see what feedback exists on the document.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "open",
                "resolved",
                "all"
              ],
              "description": "Filter by comment status. Defaults to 'all'."
            }
          }
        },
        "canBeReferencedInPrompt": true
      },
      {
        "name": "mdcolab_replyToComment",
        "tags": [
          "mdcolab",
          "comment",
          "review",
          "markdown"
        ],
        "toolReferenceName": "mdcolabReplyToComment",
        "displayName": "Reply to mdcolab Comment",
        "modelDescription": "Reply to an existing review comment thread by issue number. Use this after listing comments to respond to specific feedback.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "issueNumber": {
              "type": "number",
              "description": "The GitHub Issue number of the comment thread to reply to."
            },
            "body": {
              "type": "string",
              "description": "The reply text."
            }
          },
          "required": [
            "issueNumber",
            "body"
          ]
        },
        "canBeReferencedInPrompt": true
      },
      {
        "name": "mdcolab_resolveComment",
        "tags": [
          "mdcolab",
          "comment",
          "review",
          "markdown"
        ],
        "toolReferenceName": "mdcolabResolveComment",
        "displayName": "Resolve mdcolab Comment",
        "modelDescription": "Resolve (close) a review comment thread by issue number. Use this when feedback has been addressed.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "issueNumber": {
              "type": "number",
              "description": "The GitHub Issue number of the comment thread to resolve."
            }
          },
          "required": [
            "issueNumber"
          ]
        },
        "canBeReferencedInPrompt": true
      }
    ],
    "commands": [
      {
        "command": "mdcolab.openWysiwygEditor",
        "title": "Edit in WYSIWYG Editor",
        "category": "mdcolab",
        "icon": "$(open-preview)"
      },
      {
        "command": "mdcolab.addComment",
        "title": "Add mdcolab Comment",
        "category": "mdcolab",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "mdcolab.openInMdcolab",
        "title": "Open in mdcolab",
        "category": "mdcolab",
        "icon": "$(link-external)"
      },
      {
        "command": "mdcolab.shareLink",
        "title": "Copy mdcolab Share Link",
        "category": "mdcolab",
        "icon": "$(link)"
      },
      {
        "command": "mdcolab.shareWithMdcolab",
        "title": "Share with mdcolab...",
        "category": "mdcolab",
        "icon": "$(share)"
      },
      {
        "command": "mdcolab.refreshComments",
        "title": "Refresh Comments",
        "category": "mdcolab",
        "icon": "$(refresh)"
      },
      {
        "command": "mdcolab.refreshSharedFiles",
        "title": "Refresh Shared Files",
        "category": "mdcolab",
        "icon": "$(refresh)"
      },
      {
        "command": "mdcolab.openSharedFile",
        "title": "Open Shared File",
        "category": "mdcolab"
      },
      {
        "command": "mdcolab.unshareFile",
        "title": "Stop Sharing",
        "category": "mdcolab",
        "icon": "$(trash)"
      },
      {
        "command": "mdcolab.saveAndPushFile",
        "title": "Save and Push",
        "category": "mdcolab",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "mdcolab.enablePrivateRepoAccess",
        "title": "Enable Private Repo Access",
        "category": "mdcolab"
      },
      {
        "command": "mdcolab.resolveThread",
        "title": "Resolve Thread",
        "category": "mdcolab",
        "icon": "$(check)"
      },
      {
        "command": "mdcolab.reopenThread",
        "title": "Reopen Thread",
        "category": "mdcolab",
        "icon": "$(issue-reopened)"
      },
      {
        "command": "mdcolab.copyShareLink",
        "title": "Copy Share Link",
        "category": "mdcolab",
        "icon": "$(link)"
      },
      {
        "command": "mdcolab.openSharedFileInBrowser",
        "title": "Open in mdcolab (Web)",
        "category": "mdcolab",
        "icon": "$(link-external)"
      },
      {
        "command": "mdcolab.openSharedFileOnGitHub",
        "title": "Open on GitHub",
        "category": "mdcolab",
        "icon": "$(github)"
      },
      {
        "command": "mdcolab.revealSharedFile",
        "title": "Reveal in Explorer",
        "category": "mdcolab"
      },
      {
        "command": "mdcolab.copyThreadLink",
        "title": "Copy Comment Link",
        "category": "mdcolab",
        "icon": "$(link)"
      },
      {
        "command": "mdcolab.openThreadOnGitHub",
        "title": "Open Issue on GitHub",
        "category": "mdcolab",
        "icon": "$(github)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "mdcolab.openWysiwygEditor",
          "when": "resourceLangId == markdown",
          "group": "mdcolab@0"
        },
        {
          "command": "mdcolab.addComment",
          "when": "editorHasSelection && resourceLangId == markdown",
          "group": "mdcolab"
        },
        {
          "command": "mdcolab.openInMdcolab",
          "when": "resourceLangId == markdown || resourceLangId == html",
          "group": "mdcolab"
        },
        {
          "command": "mdcolab.shareLink",
          "when": "resourceLangId == markdown || resourceLangId == html",
          "group": "mdcolab"
        }
      ],
      "explorer/context": [
        {
          "command": "mdcolab.openWysiwygEditor",
          "when": "resourceLangId == markdown",
          "group": "mdcolab@0"
        },
        {
          "command": "mdcolab.openInMdcolab",
          "when": "resourceLangId == markdown || resourceLangId == html",
          "group": "mdcolab@1"
        },
        {
          "command": "mdcolab.shareWithMdcolab",
          "when": "resourceLangId == markdown || resourceLangId == html",
          "group": "mdcolab@2"
        }
      ],
      "editor/title": [
        {
          "command": "mdcolab.openWysiwygEditor",
          "when": "resourceLangId == markdown",
          "group": "navigation"
        },
        {
          "command": "mdcolab.refreshComments",
          "when": "resourceLangId == markdown || resourceLangId == html",
          "group": "navigation"
        }
      ],
      "editor/title/context": [
        {
          "command": "mdcolab.openWysiwygEditor",
          "when": "resourceLangId == markdown",
          "group": "mdcolab@0"
        },
        {
          "command": "mdcolab.openInMdcolab",
          "when": "resourceLangId == markdown || resourceLangId == html",
          "group": "mdcolab@1"
        },
        {
          "command": "mdcolab.shareLink",
          "when": "resourceLangId == markdown || resourceLangId == html",
          "group": "mdcolab@2"
        },
        {
          "command": "mdcolab.shareWithMdcolab",
          "when": "resourceLangId == markdown || resourceLangId == html",
          "group": "mdcolab@3"
        }
      ],
      "view/title": [
        {
          "command": "mdcolab.refreshComments",
          "when": "view == mdcolab.commentsView",
          "group": "navigation"
        },
        {
          "command": "mdcolab.refreshSharedFiles",
          "when": "view == mdcolab.sharedFilesView",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "mdcolab.resolveThread",
          "when": "view == mdcolab.commentsView && viewItem == openThread",
          "group": "inline"
        },
        {
          "command": "mdcolab.reopenThread",
          "when": "view == mdcolab.commentsView && viewItem == resolvedThread",
          "group": "inline"
        },
        {
          "command": "mdcolab.copyThreadLink",
          "when": "view == mdcolab.commentsView && (viewItem == openThread || viewItem == resolvedThread)",
          "group": "1_link@1"
        },
        {
          "command": "mdcolab.openThreadOnGitHub",
          "when": "view == mdcolab.commentsView && (viewItem == openThread || viewItem == resolvedThread)",
          "group": "1_link@2"
        },
        {
          "command": "mdcolab.resolveThread",
          "when": "view == mdcolab.commentsView && viewItem == openThread",
          "group": "2_modification@1"
        },
        {
          "command": "mdcolab.reopenThread",
          "when": "view == mdcolab.commentsView && viewItem == resolvedThread",
          "group": "2_modification@1"
        },
        {
          "command": "mdcolab.saveAndPushFile",
          "when": "view == mdcolab.sharedFilesView && viewItem =~ /Dirty$/",
          "group": "inline@1"
        },
        {
          "command": "mdcolab.unshareFile",
          "when": "view == mdcolab.sharedFilesView && viewItem =~ /^sharedFile/",
          "group": "inline@2"
        },
        {
          "command": "mdcolab.openSharedFile",
          "when": "view == mdcolab.sharedFilesView && viewItem =~ /^sharedFile/",
          "group": "1_open@1"
        },
        {
          "command": "mdcolab.openSharedFileInBrowser",
          "when": "view == mdcolab.sharedFilesView && viewItem =~ /^sharedFile/",
          "group": "1_open@2"
        },
        {
          "command": "mdcolab.openSharedFileOnGitHub",
          "when": "view == mdcolab.sharedFilesView && viewItem =~ /^sharedFile/",
          "group": "1_open@3"
        },
        {
          "command": "mdcolab.revealSharedFile",
          "when": "view == mdcolab.sharedFilesView && viewItem =~ /^sharedFile/",
          "group": "1_open@4"
        },
        {
          "command": "mdcolab.copyShareLink",
          "when": "view == mdcolab.sharedFilesView && viewItem =~ /^sharedFile/",
          "group": "2_link@1"
        },
        {
          "command": "mdcolab.saveAndPushFile",
          "when": "view == mdcolab.sharedFilesView && viewItem =~ /Dirty$/",
          "group": "3_modification@1"
        },
        {
          "command": "mdcolab.unshareFile",
          "when": "view == mdcolab.sharedFilesView && viewItem =~ /^sharedFile/",
          "group": "3_modification@2"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mdcolab",
          "title": "mdcolab",
          "icon": "media/mdcolab-activity.svg"
        }
      ]
    },
    "views": {
      "mdcolab": [
        {
          "id": "mdcolab.commentsView",
          "name": "Comments"
        },
        {
          "id": "mdcolab.sharedFilesView",
          "name": "Shared Files"
        }
      ]
    },
    "keybindings": [
      {
        "command": "mdcolab.addComment",
        "key": "ctrl+alt+m",
        "mac": "cmd+alt+m",
        "when": "editorHasSelection && resourceLangId == markdown"
      }
    ],
    "configuration": {
      "title": "mdcolab",
      "properties": {
        "mdcolab.webAppUrl": {
          "type": "string",
          "default": "https://ca-web-ai-preview.calmflower-64b2252f.eastus2.azurecontainerapps.io",
          "description": "Base URL for the mdcolab web application"
        },
        "mdcolab.autoRefreshInterval": {
          "type": "number",
          "default": 30,
          "description": "Auto-refresh interval for comments in seconds (0 to disable)"
        },
        "mdcolab.privateRepoAccess": {
          "type": "boolean",
          "default": false,
          "description": "Request full repo scope for private repository access. When disabled, only public repositories are accessible (recommended for minimal permissions)."
        },
        "mdcolab.orgAccountMappings": {
          "type": "array",
          "default": [],
          "description": "Map GitHub orgs to specific accounts. When working with a repo owned by a mapped org, mdcolab will request authentication with that account.",
          "items": {
            "type": "object",
            "properties": {
              "org": {
                "type": "string",
                "description": "GitHub organization name (e.g. 'coreai-microsoft')"
              },
              "account": {
                "type": "string",
                "description": "GitHub account username to use for this org (e.g. 'charris_microsoft')"
              }
            },
            "required": ["org", "account"]
          }
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run bundle",
    "compile": "tsc -p ./",
    "bundle": "node esbuild.extension.mjs",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src",
    "test": "node ./out/test/runTest.js",
    "test:unit": "tsc -p ./ && node ./out/test/run-unit-tests.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.0",
    "@types/node": "^20.0.0",
    "@types/sinon": "^21.0.0",
    "@types/vscode": "^1.116.0",
    "@vscode/test-electron": "^2.4.0",
    "@vscode/vsce": "^3.0.0",
    "glob": "^11.0.0",
    "mocha": "^10.8.0",
    "sinon": "^21.0.1",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "@octokit/rest": "^20.1.2",
    "mermaid": "^11.14.0"
  }
}
